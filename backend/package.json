    "@hono/zod-validator": "^0.2.2",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.31.2",
    "postgres": "^3.4.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "tsx": "^4.15.6",
    "drizzle-kit": "^0.22.7",
    "vitest": "^2.1.9"
  }
}
