# Variables d'environnement — Backend Mythenena
# Copier ce fichier en .env et remplir les valeurs

# Supabase — récupérer depuis Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# JWT — générer une clé aléatoire forte
JWT_SECRET=change_me_random_string_32_chars_minimum

# URL du site web (pour CORS)
WEB_URL=http://localhost:3000

# Port du serveur
PORT=4000
