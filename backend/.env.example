# Variables d'environnement — Backend Mythenena
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais versionner le fichier .env.

# --- Supabase — PostgreSQL direct -------------------------------------------
# Supabase > Settings > Database > Connection string > URI
# Remplacer [YOUR-PASSWORD] par votre mot de passe Supabase
# Projet : ncyqundhbieqlpbyawmk
DATABASE_URL=postgresql://postgres.ncyqundhbieqlpbyawmk:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Sécurité ---------------------------------------------------------------
# Clé aléatoire forte, 32 caractères minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_random_string_32_chars_minimum

# Durée de validité du jeton de session anonyme, en jours (1 à 365).
JWT_TTL_DAYS=30

# --- Serveur ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Origines autorisées par CORS, séparées par des virgules.
# Si la variable est absente, WEB_URL + les adresses Expo par défaut sont utilisées.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081
WEB_URL=http://localhost:3000

# --- Modération humaine -----------------------------------------------------
# Jetons statiques des modérateurs du forum, séparés par des virgules.
# Sans valeur, l'espace /api/moderation reste inaccessible.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MODERATOR_TOKENS=

# --- IA : Gemini (Google AI Studio) -----------------------------------------
# https://aistudio.google.com/ — compte Google suffisant, Free Tier disponible
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_LANGUAGE=mg-MG

# --- IA : Groq Whisper (transcription vocale) --------------------------------
# https://console.groq.com/keys — compte gratuit, Free Tier disponible
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
