{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web (Chrome)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "command": "npm run dev",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "killOnServerStop": true
      }
    },
    {
      "name": "Backend (debug)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "command": "npm run dev",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (Chrome)",
      "configurations": ["Web (Chrome)", "Backend (debug)"],
      "stopAll": true
    }
  ]
}
